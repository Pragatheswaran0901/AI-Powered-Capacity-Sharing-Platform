# ==========================================
# MACH-HUNT — Production Environment Configuration
# ==========================================

# Database Configuration (PostgreSQL in production, SQLite fallback for rapid local dev)
DATABASE_URL=postgresql://machhunt:machhunt_secure_password_2026@localhost:5432/machhunt
# DATABASE_URL=sqlite:///./machhunt_v2.db

# Authentication & Cryptographic Tokens
JWT_SECRET=replace_with_a_64_character_hex_random_secret_in_production
JWT_REFRESH_SECRET=replace_with_a_separate_64_character_hex_refresh_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Transactional Email & Passwordless OTP Configuration
EMAIL_PROVIDER=development # Options: development, smtp, resend, sendgrid
EMAIL_MODE=development     # Options: development, production
EMAIL_API_KEY=
EMAIL_FROM=no-reply@machhunt.com
EMAIL_FROM_NAME=Mach-Hunt
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# OTP Policies & Rate Limiting
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5

# Artificial Intelligence Requirement Interpreter
AI_PROVIDER=nlp_engine # Options: nlp_engine, openai, anthropic, gemini
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-pro

# Escrow & Payment Gateway Integration
PAYMENT_PROVIDER=escrow_simulated # Options: escrow_simulated, razorpay, stripe, cashfree
PAYMENT_SECRET=rzp_live_secret_key_placeholder
PAYMENT_WEBHOOK_SECRET=rzp_webhook_secret_placeholder
PLATFORM_COMMISSION_PERCENT=5.0

# Geographic & Map Distance Providers
MAPS_PROVIDER=haversine # Options: haversine, google_maps, mapmyindia
MAPS_API_KEY=

# Manufacturing CAD/Drawing Secure Storage
STORAGE_PROVIDER=local # Options: local, s3, gcs
STORAGE_BUCKET_NAME=machhunt-drawings-private
STORAGE_SECRET_KEY=

# Server & Network Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:3000","*"]
