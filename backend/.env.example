# Dedicated Gmail OTP Configuration for Mach-Hunt
DATABASE_URL=sqlite:///./machhunt_v2.db
JWT_SECRET=replace_with_a_64_character_hex_random_secret_in_production
JWT_REFRESH_SECRET=replace_with_a_separate_64_character_hex_refresh_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Dedicated Gmail SMTP
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=machhunt2212@gmail.com
SMTP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
SMTP_FROM_EMAIL=machhunt2212@gmail.com
SMTP_USE_TLS=true
EMAIL_FROM_NAME=Mach-Hunt

# OTP Policies
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
